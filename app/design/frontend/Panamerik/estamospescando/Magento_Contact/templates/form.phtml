$recaptcha = $block->getData('viewModelRecaptcha');
?>

<div class="ep-hero" style="margin-bottom:32px;">
    <h1><?= $escaper->escapeHtml(__('Write Us')) ?></h1>
    <p><?= $escaper->escapeHtml(__("Jot us a note and we\u{2019}ll get back to you as quickly as possible.")) ?></p>
</div>

<div class="flex flex-col md:flex-row gap-6 mb-8">
