                        </label>
                        <textarea name="comment" id="comment" required
                                  title="<?= $escaper->escapeHtmlAttr(__("What\u{2019}s on your mind?")) ?>"
                                  class="form-input w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500 py-3 px-4 h-40"
                                  cols="5" rows="3"><?= $escaper->escapeHtml($contactHelper->getPostValue('comment')) ?></textarea>
                    </div>

                    <?= $block->getChildHtml('form.additional.info') ?>
                    <?= $recaptcha ? $recaptcha->getInputHtml(ReCaptcha::RECAPTCHA_FORM_ID_CONTACT) : '' ?>
                </fieldset>

                <div class="mt-4">
                    <?= $block->getBlockHtml('formkey') ?>
                    <button type="submit"
                            title="<?= $escaper->escapeHtmlAttr(__('Submit')) ?>"
